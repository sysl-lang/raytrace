// A bounding-volume hierarchy: a binary tree of boxes, so that a ray tests the objects near its path
// and skips the rest. Built top-down by Shirley's rule -- sort along the longest axis of the node's
// box and split the list in half.

import sysl.buf.{Buf, buf}
import sysl.slices.sort_by

struct BvhNode
    left: &sync Hittable
    right: &sync Hittable
    bounds: Aabb

impl Hittable for BvhNode
    hit(self, r: Ray, ray_t: Interval) -> Option[Hit]
        if !self.bounds.hit(r, ray_t) then return None

        val hl = self.left.hit(r, ray_t)
        val far = hl match
            Some(h) -> h.t
            None -> ray_t.hi

        self.right.hit(r, Interval(ray_t.lo, far)) match
            Some(h) -> Some(h)
            None -> hl
    end hit

    bbox(self) -> Aabb = self.bounds

/** The hierarchy over `items`. The buffer is reordered in place; an empty one gives an empty list,
 * which nothing hits.
 */
bvh(items: Buf[&sync Hittable]) -> &sync Hittable
    if items.len() == 0 then return Nothing()
    build(items.view())

/** The empty scene. */
struct Nothing
end Nothing

impl Hittable for Nothing
    hit(self, r: Ray, ray_t: Interval) -> Option[Hit] = None

    bbox(self) -> Aabb = Aabb.empty()

private build(xs: []&sync Hittable) -> &sync Hittable
    if xs.len == 1 then return xs[0]

    var bounds = Aabb.empty()
    for x in xs
        bounds = Aabb.hull(bounds, x.bbox())

    if xs.len == 2 then return BvhNode(xs[0], xs[1], bounds)

    val axis = bounds.longest_axis()
    sort_by(xs, (a, b) -> a.bbox().axis(axis).lo < b.bbox().axis(axis).lo)

    val mid = xs.len / 2
    BvhNode(build(xs[..<mid]), build(xs[mid..]), bounds)
end build
