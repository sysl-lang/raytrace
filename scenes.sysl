// The scenes the program renders: every feature in one picture, and the Cornell box.

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8

val planet_png: []const u8 = embed("assets/planet.png")
val icosphere_obj: []const u8 = embed("assets/icosphere.obj")

struct Scene
    world: &sync Hittable
    view: View
    background: Vec3

/** The planet texture, decoded from the PNG compiled into the program.
 *
 * **It is not in a scene yet, and that is a gap in sysl rather than a choice.** The scene is shared
 * by the render threads, so every texture in it is a `&sync Texture` -- and a `&sync` object may not
 * hold a view (`[]u8`), nor a `Buf`, since neither says its count is atomic. There is no spelling of
 * "a heap buffer, built once, read by every thread", short of a lock around every texel or a raw
 * pointer whose owner lives somewhere else. The texture itself works, and the tests read it.
 */
planet() -> ImageTexture
    var bytes: []u8 = [0; planet_png.len]
    for i in 0..<planet_png.len
        bytes[i] = planet_png[i]

    val img = read_png(bytes).expect("the embedded planet.png decodes")
    ImageTexture(img.width, img.height, img.bytes)

/** Everything at once: a checkered floor, the three materials of the first book side by side, a
 * marble ball, a textured planet, a moving sphere blurred by the shutter, a triangle mesh in a glass
 * shell, and an area light -- under a pale sky, through a lens focused on the middle row.
 */
showcase() -> Scene
    val items: Buf[&sync Hittable] = buf()
    val floor: &sync Material = Lambertian(Checker.of(0.5, Vec3(0.2, 0.3, 0.1), Vec3(0.9, 0.9, 0.9)))

    items.push(Sphere.still(Vec3(0.0, -1000.0, 0.0), 1000.0, floor))

    items.push(Sphere.still(Vec3(-2.2, 1.0, 0.0), 1.0, Lambertian(Solid(Vec3(0.7, 0.3, 0.2)))))
    items.push(Sphere.still(Vec3(0.0, 1.0, 0.0), 1.0, Dielectric(1.5)))
    items.push(Sphere.still(Vec3(0.0, 1.0, 0.0), -0.8, Dielectric(1.5)))
    items.push(Sphere.still(Vec3(2.2, 1.0, 0.0), 1.0, Metal(Vec3(0.8, 0.8, 0.85), 0.05)))

    items.push(Sphere.still(Vec3(-1.4, 0.5, 2.0), 0.5, Lambertian(Marble(Perlin.of(42), 4.0))))
    items.push(Sphere.still(Vec3(1.3, 0.6, 2.1), 0.6, Lambertian(Checker.of(0.15, Vec3(0.1, 0.2, 0.6), Vec3(0.9, 0.8, 0.2)))))
    items.push(Sphere.moving(Vec3(0.1, 0.35, 2.4), Vec3(0.1, 0.6, 2.4), 0.35, Lambertian(Solid(Vec3(0.2, 0.4, 0.9)))))

    val gold: &sync Material = Metal(Vec3(0.9, 0.7, 0.3), 0.2)
    val mesh = read_obj(from_utf8(icosphere_obj).expect("icosphere.obj is text"),0.55, Vec3(-0.5, 0.55, -2.0), gold).expect("icosphere.obj")
    items.push(bvh(mesh))

    val light: &sync Material = DiffuseLight(Solid(Vec3(6.0, 6.0, 5.0)))
    items.push(Quad.of(Vec3(-1.5, 4.5, -1.0), Vec3(3.0, 0.0, 0.0), Vec3(0.0, 0.0, 2.0), light))

    Scene(bvh(items), View(Vec3(0.0, 2.2, 7.5), Vec3(0.0, 0.8, 0.0), Vec3(0.0, 1.0, 0.0), 35.0, 0.6, 7.6),
        Vec3(0.5, 0.6, 0.75))
end showcase

/** The Cornell box: red and green walls, a white floor, ceiling and back, a square light in the
 * ceiling, and two white boxes turned against each other.
 */
cornell() -> Scene
    val items: Buf[&sync Hittable] = buf()
    val red: &sync Material = Lambertian(Solid(Vec3(0.65, 0.05, 0.05)))
    val white: &sync Material = Lambertian(Solid(Vec3(0.73, 0.73, 0.73)))
    val green: &sync Material = Lambertian(Solid(Vec3(0.12, 0.45, 0.15)))
    val light: &sync Material = DiffuseLight(Solid(Vec3(15.0, 15.0, 15.0)))

    items.push(Quad.of(Vec3(555.0, 0.0, 0.0), Vec3(0.0, 555.0, 0.0), Vec3(0.0, 0.0, 555.0), green))
    items.push(Quad.of(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 555.0, 0.0), Vec3(0.0, 0.0, 555.0), red))
    items.push(Quad.of(Vec3(343.0, 554.0, 332.0), Vec3(-130.0, 0.0, 0.0), Vec3(0.0, 0.0, -105.0), light))
    items.push(Quad.of(Vec3(0.0, 0.0, 0.0), Vec3(555.0, 0.0, 0.0), Vec3(0.0, 0.0, 555.0), white))
    items.push(Quad.of(Vec3(555.0, 555.0, 555.0), Vec3(-555.0, 0.0, 0.0), Vec3(0.0, 0.0, -555.0), white))
    items.push(Quad.of(Vec3(0.0, 0.0, 555.0), Vec3(555.0, 0.0, 0.0), Vec3(0.0, 555.0, 0.0), white))

    val tall = RotateY.of(cuboid(Vec3.zero(), Vec3(165.0, 330.0, 165.0), white), 15.0)
    items.push(Translate.of(tall, Vec3(265.0, 0.0, 295.0)))

    val short = RotateY.of(cuboid(Vec3.zero(), Vec3(165.0, 165.0, 165.0), white), -18.0)
    items.push(Translate.of(short, Vec3(130.0, 0.0, 65.0)))

    Scene(bvh(items), View(Vec3(278.0, 278.0, -800.0), Vec3(278.0, 278.0, 0.0), Vec3(0.0, 1.0, 0.0), 40.0, 0.0, 10.0),
        Vec3.zero())
end cornell

/** The scene called `name`, if there is one. */
scene_named(name: string) -> Option[Scene]
    if name == "showcase" then return Some(showcase())
    if name == "cornell" then return Some(cornell())
    None
